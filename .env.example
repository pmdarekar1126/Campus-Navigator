# Copy this file to .env and paste your key after the = sign.
# .env is gitignored and is never served to the browser.

ASSISTANT_API_KEY=

# The answer service endpoint. Leave as is unless the model is retired,
# in which case the server log prints the replacement to use.
ASSISTANT_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/models/gemini-3.6-flash:generateContent
